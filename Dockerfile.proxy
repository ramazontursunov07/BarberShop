# Frontend (React) ni build qiladi va Caddy bilan birga tarqatadi.
# docker-compose.yml dagi `proxy` xizmati shu faylni ishlatadi.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv/frontend
# Caddyfile docker-compose.yml orqali ulanadi (serverda tahrirlash oson bo'lishi uchun)
