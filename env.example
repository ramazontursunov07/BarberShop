# --- Django ---
SECRET_KEY=                       # python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
DOMAIN=barber.example.uz          # Caddy shu domen uchun HTTPS sertifikat oladi
ALLOWED_HOSTS=barber.example.uz   # vergul bilan
CSRF_TRUSTED_ORIGINS=https://barber.example.uz
CORS_ALLOWED_ORIGINS=https://app.example.uz
# HTTPS ni nginx/Caddy tugatadi; faqat lokal sinovda http bilan: SECURE_SSL_REDIRECT=False
SECURE_SSL_REDIRECT=True

# --- Baza (docker compose o'zi DATABASE_URL beradi; lokal SQLite uchun bo'sh qoldiring) ---
POSTGRES_PASSWORD=change-me

# --- AI ---
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
STT_API_KEY=
STT_LANGUAGE=uz

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET=              # bot va backend bir xil maxfiy kalit (uzun tasodifiy qator)
