# DOMAIN .env dan olinadi (DNS shu serverga qaragan bo'lishi kerak: HTTPS sertifikat avtomatik olinadi)
{$DOMAIN} {
	encode gzip

	# API, Django admin, health va admin static fayllari: Django'ga
	@backend path /api/* /admin/* /health/ /static/*
	handle @backend {
		reverse_proxy web:8000
	}

	# Yuklangan rasmlar
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Qolgan hamma narsa: React ilovasi (sahifa topilmasa index.html, React Router o'zi hal qiladi)
	handle {
		root * /srv/frontend
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
